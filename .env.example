APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MOCK_MODE=true
QWEN_MAX_TOKENS_PARSE=350
QWEN_MAX_TOKENS_EMAIL=500
QWEN_MAX_TOKENS_EMAIL_DRAFT=500
QWEN_MAX_TOKENS_EXPIRY=350
QWEN_MAX_TOKENS_STOCK_REASONING=300
QWEN_MAX_TOKENS_RESTOCK_DECISION=220
QWEN_TEMPERATURE=0.2
QWEN_CACHE_MINUTES=30
QWEN_STOCK_REASONING_CACHE_MINUTES=30
QWEN_EMAIL_DRAFT_CACHE_MINUTES=30

STOCK_PREDICTION_API_URL=http://127.0.0.1:8001
STOCK_PREDICTION_TIMEOUT=8
STOCK_PREDICTION_CACHE_MINUTES=30

# Phase 1 autopilot safety controls. Automatic drafts and real delivery are off by default.
AUTOPILOT_PO_DRAFT_ENABLED=false
AUTOPILOT_MINIMUM_CONFIDENCE=0.75
AUTOPILOT_SCAN_DEDUPE_MINUTES=30
REAL_EMAIL_ENABLED=false

DB_CONNECTION=sqlite
# To use Supabase PostgreSQL, set DB_CONNECTION=supabase and fill these values.
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_DATABASE=postgres
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_SCHEMA=public
# SUPABASE_DB_SSLMODE=require
# SUPABASE_DB_URL=

# Optional Supabase API values for future Storage, Edge Functions, or REST usage.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional explicit Gmail delivery for approved supplier email drafts.
# Keep REAL_EMAIL_ENABLED=false until Gmail SMTP is configured and tested.
# Example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME="Ting Hao"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
